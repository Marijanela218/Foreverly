@model IEnumerable<Foreverly.Models.Wedding>

@{
    ViewData["Title"] = "Weddings";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Wedding Management</h1>
            <p class="text-muted">Pregled i upravljanje svim vjenčanjima</p>
        </div>

        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            + Add Wedding
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h6 class="text-muted">Total Weddings</h6>
                    <h2 class="fw-bold">@Model.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h6 class="text-muted">Planned</h6>
                    <h2 class="fw-bold">@Model.Count(w => w.Status == "Planned")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h6 class="text-muted">Confirmed</h6>
                    <h2 class="fw-bold">@Model.Count(w => w.Status == "Confirmed")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Confirmed Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ClientName</td>
                            <td>@item.ClientPhone</td>
                            <td>@item.ClientEmail</td>
                            <td>@item.ConfirmedDate</td>
                            <td>
                                @if (item.Status == "Planned")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill me-2">
                                        Planned
                                    </span>

                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <button type="submit" class="btn btn-success btn-sm">
                                            Confirm
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill me-2">
                                        Confirmed
                                    </span>

                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <button type="submit" class="btn btn-warning btn-sm">
                                            Set Planned
                                        </button>
                                    </form>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>