@model Foreverly.Models.Wedding

@{
    ViewData["Title"] = "Wedding Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">@Model.ClientName</h1>
        <p class="text-muted mb-0">Wedding details and services overview</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Seating"
               asp-action="Index"
               asp-route-id="@Model.Id"
               class="btn btn-success">
            Seating Plan
        </a>

        <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-warning">
            Edit
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Status</h6>
                <span class="badge @(Model.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark") fs-6">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Confirmed Date</h6>
                <h5>@Model.ConfirmedDate</h5>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Total Price</h6>
                <h5>@ViewBag.TotalPrice.ToString("F2") KM</h5>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Commission</h6>
                <h5>@ViewBag.TotalCommission.ToString("F2") KM</h5>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Client Information</h5>
            </div>

            <div class="card-body">
                <p><strong>Name:</strong> @Model.ClientName</p>
                <p><strong>Phone:</strong> @Model.ClientPhone</p>
                <p><strong>Email:</strong> @Model.ClientEmail</p>
                <p><strong>Address:</strong> @Model.ClientAddress</p>
                <p><strong>Notes:</strong> @(Model.Notes ?? "No notes")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Wedding Summary</h5>
            </div>

            <div class="card-body">
                <p><strong>Suggested Date:</strong> @Model.SuggestedDate</p>
                <p><strong>Confirmed Date:</strong> @Model.ConfirmedDate</p>
                <p><strong>Template:</strong> @(Model.Template?.Name ?? "No template")</p>
                <p><strong>Total Services:</strong> @(Model.WeddingServices?.Count ?? 0)</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Add Service to Wedding</h5>
    </div>

    <div class="card-body">
        <form asp-action="AddService" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="WeddingId" value="@Model.Id" />

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Partner</label>
                    <select id="partnerSelect"
                            name="PartnerId"
                            class="form-select"
                            asp-items="ViewBag.Partners">
                    </select>

                    <input type="hidden"
                           id="partnerCommission"
                           value='@Html.Raw(ViewBag.PartnerCommissions)' />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Service Type</label>
                    <select name="ServiceType" class="form-select">
                        <option value="General">General</option>
                        <option value="Band/DJ">Band/DJ</option>
                        <option value="Restaurant">Restaurant</option>
                        <option value="Florist">Florist</option>
                        <option value="Cake">Cake</option>
                        <option value="Catering">Catering</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Quantity</label>
                    <input name="Quantity"
                           type="number"
                           class="form-control"
                           value="1"
                           min="1" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Unit Price</label>
                    <input name="UnitPrice"
                           type="number"
                           step="0.01"
                           class="form-control"
                           value="0" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Commission %</label>
                    <input name="CommissionPercent"
                           id="commissionPercent"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <div class="form-check">
                        <input name="Confirmed"
                               value="true"
                               type="checkbox"
                               class="form-check-input" />
                        <label class="form-check-label">
                            Yes
                        </label>
                    </div>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary px-5">
                        Add Service
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Wedding Services</h5>
    </div>

    <div class="card-body">

        @if (Model.WeddingServices != null && Model.WeddingServices.Any())
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Partner</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Commission</th>
                        <th>Confirmed</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var service in Model.WeddingServices)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @if (service.Partner != null)
                                {
                                    <a asp-controller="Partners"
                                           asp-action="Details"
                                           asp-route-id="@service.Partner.Id"
                                           class="text-decoration-none">
                                        @service.Partner.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No partner</span>
                                }
                            </td>
                            <td>@service.ServiceType</td>
                            <td>@service.Quantity</td>
                            <td>@service.UnitPrice.ToString("F2") KM</td>
                            <td>@service.TotalPrice.ToString("F2") KM</td>
                            <td>@service.CommissionAmount.ToString("F2") KM</td>
                            <td>
                                @if (service.Confirmed)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteService" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="serviceId" value="@service.Id" />
                                    <input type="hidden" name="weddingId" value="@Model.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this service?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No services added for this wedding.</p>
        }

    </div>
</div>

<div class="d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>

    <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-warning">
        Edit Wedding
    </a>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const partnerCommissionInput = document.getElementById("partnerCommission");
        const partnerSelect = document.getElementById("partnerSelect");
        const commissionInput = document.getElementById("commissionPercent");

        if (!partnerCommissionInput || !partnerSelect || !commissionInput) {
            return;
        }

        const commissions = JSON.parse(partnerCommissionInput.value || "{}");

        function updateCommission() {
            const partnerId = partnerSelect.value;

            if (commissions[partnerId]) {
                commissionInput.value =
    Number(commissions[partnerId]).toFixed(2);
            } else {
                commissionInput.value = 0;
            }
        }

        partnerSelect.addEventListener("change", updateCommission);
        updateCommission();
    });
</script>