@model Foreverly.Models.WeddingService

@{
    ViewData["Title"] = "Add Service";
}

<h1>Add Service</h1>

<form asp-action="AddService" method="post">
    <input type="hidden" asp-for="WeddingId" />

    <div class="mb-3">
        <label asp-for="PartnerId" class="form-label">Partner</label>
        <select asp-for="PartnerId" class="form-control" asp-items="ViewBag.Partners"></select>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceType" class="form-label">Service Type</label>
        <select asp-for="ServiceType" class="form-control">
            <option value="Band">Band / DJ</option>
            <option value="Florist">Florist</option>
            <option value="Restaurant">Restaurant</option>
            <option value="Hall">Hall</option>
            <option value="Cake">Cake</option>
            <option value="Catering">Catering</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="UnitPrice" class="form-label">Unit Price</label>
        <input asp-for="UnitPrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CommissionPercent" class="form-label">Commission %</label>
        <input asp-for="CommissionPercent" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SpecialRequest" class="form-label">Special Request</label>
        <textarea asp-for="SpecialRequest" class="form-control"></textarea>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Confirmed" class="form-check-input" />
        <label asp-for="Confirmed" class="form-check-label">Confirmed</label>
    </div>

    <button type="submit" class="btn btn-primary">Save Service</button>
    <a asp-action="Details" asp-route-id="@Model.WeddingId" class="btn btn-secondary">Back</a>
</form>