@model Foreverly.Models.Wedding

@{
    ViewData["Title"] = "Create Wedding";
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-header bg-white">
                <h1 class="mb-0">Create Wedding</h1>
            </div>

            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="SuggestedDate" class="form-label">
                                Suggested Date
                            </label>
                            <input asp-for="SuggestedDate" class="form-control" />
                            <span asp-validation-for="SuggestedDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmedDate" class="form-label">
                                Confirmed Date
                            </label>
                            <input asp-for="ConfirmedDate" class="form-control" />
                            <span asp-validation-for="ConfirmedDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">
                                Status
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Confirmed">Confirmed</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClientName" class="form-label">
                                Client Name
                            </label>
                            <input asp-for="ClientName" class="form-control" />
                            <span asp-validation-for="ClientName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClientPhone" class="form-label">
                                Client Phone
                            </label>
                            <input asp-for="ClientPhone" class="form-control" />
                            <span asp-validation-for="ClientPhone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClientEmail" class="form-label">
                                Client Email
                            </label>
                            <input asp-for="ClientEmail" class="form-control" />
                            <span asp-validation-for="ClientEmail" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ClientAddress" class="form-label">
                                Client Address
                            </label>
                            <input asp-for="ClientAddress" class="form-control" />
                            <span asp-validation-for="ClientAddress" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label">
                                Notes
                            </label>
                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="5"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="TemplateId" value="1" />

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            Back to List
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Create Wedding
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}