@model Foreverly.Models.Wedding

@{
    ViewData["Title"] = "Seating Plan";
    var tables = Model.Tables.ToList();

    var assignedGuestIds = Model.Tables
        .SelectMany(t => t.SeatingAssignments)
        .Select(sa => sa.GuestId)
        .ToHashSet();
}

<h1 class="mb-4">Seating Plan</h1>

<div class="row">

    <!-- GUESTS -->
    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Guests</span>

                <button class="btn btn-sm btn-primary"
                        onclick="showAddGuestModal()">
                    + Add Guest
                </button>
            </div>

            <div class="card-body"
                 id="guestList"
                 ondragover="allowDrop(event)"
                 ondrop="dropToGuestList(event)">

                <input id="guestSearch"
                       class="form-control mb-3"
                       placeholder="Search guest..."
                       oninput="filterGuests()" />

                <!-- EMPTY STATE -->
                <div id="noGuestsMessage"
                     style="display:none; color:#dc3545; font-weight:600; margin-bottom:10px;">
                    No guests found
                </div>

                <!-- LIST WRAPPER -->
                <div id="guestList">

                    @foreach (var guest in Model.Guests
                        .Where(g => !assignedGuestIds.Contains(g.Id))
                        .OrderBy(g => g.FullName))
                    {
                        <div class="guest-card mb-2 d-flex justify-content-between align-items-center"
                             draggable="true"
                             data-guest-id="@guest.Id">

                            <div>
                                <strong class="guest-name">@guest.FullName</strong>

                                @if (!string.IsNullOrEmpty(guest.Side))
                                {
                                    <small class="text-muted">
                                        (@guest.Side)
                                    </small>
                                }
                            </div>

                            <div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="showEditGuestModal(@guest.Id)">
                                    ✏️
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="deleteGuest(@guest.Id)">
                                    ✕
                                </button>
                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>
    </div>

 
    <!-- TABLES -->
    <div class="col-md-9">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-primary" onclick="showAddTableModal()">
                + Add Table
            </button>
        </div>

        <div class="row">

            @for (int i = 0; i < tables.Count; i++)
            {
                var table = tables[i];
                bool isFull = table.SeatingAssignments.Count >= table.Capacity;

                <div class="col-md-4 mb-4">

                    <div class="table-circle @(isFull ? "table-full" : "")"
                         data-table-id="@table.Id"
                         ondragover="allowDrop(event)"
                         ondrop="drop(event)">

                        <!-- TOP: CAPACITY -->
                        <small class="text-muted">
                            @table.SeatingAssignments.Count / @table.Capacity
                        </small>

                        <!-- MIDDLE DROP ZONE -->
                        <div class="table-guests" id="table-guests-@table.Id">

                            @foreach (var seat in table.SeatingAssignments)
                            {
                                <div class="badge bg-primary m-1 guest-in-table"
                                     data-guest-id="@seat.GuestId"
                                     draggable="true">
                                    @seat.Guest.FullName
                                </div>
                            }

                        </div>

                        <!-- CENTER NAME -->
                        <div class="table-name-center">
                            @(string.IsNullOrEmpty(table.TableName)
                                ? $"Table {i + 1}"
                                : table.TableName)
                        </div>

                        <!-- BOTTOM ACTIONS -->
                        <div class="table-actions mt-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="editTable(@table.Id, @table.Capacity, '@(table.TableName?.Replace("'", "\\'"))')">
                                ✏️
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deleteTable(@table.Id)">
                                ✕
                            </button>
                        </div>

                    </div>

                </div>
            }

        </div>
    </div>

<!-- TABLE MODAL -->
<div class="modal fade" id="tableModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="tableId" />

                <label>Table name</label>
                <input id="tableName" class="form-control mb-2" />

                <label>Capacity</label>
                <input id="tableCapacity" type="number" class="form-control mb-2" />

                <label>Side</label>
                <select id="tableSide" class="form-select">
                    <option value="">None</option>
                    <option value="Bride">Bride</option>
                    <option value="Groom">Groom</option>
                </select>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary" onclick="saveTable()">
                    Save
                </button>

            </div>

        </div>

    </div>
</div>

<!-- ADD GUEST MODAL -->

<div class="modal fade"
     id="addGuestModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Guest</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input id="guestName"
                       class="form-control"
                       placeholder="Name and Surname" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success"
                        onclick="addGuest()">
                    Add
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="editGuestModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Guest
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="editGuestId" />

                <label>Name & Surname</label>

                <input id="editGuestName"
                       class="form-control mb-3" />

                <label>Side</label>

                <select id="editGuestSide"
                        class="form-select">

                    <option value="">Select side</option>
                    <option value="Bride">Bride</option>
                    <option value="Groom">Groom</option>

                </select>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        onclick="saveGuestEdit()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>

    <style>
    /* ---------------- SEATING PAGE ---------------- */

    .guest-card {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 14px;
        border-radius: 14px;
        cursor: grab;
        transition: .2s ease-in-out;
        box-shadow: 0 8px 24px rgba(30, 58, 52, 0.04);
    }

    .guest-card:hover {
        background: #F4E9D8;
        border-color: var(--gold);
        transform: translateY(-1px);
    }

    .guest-name {
        color: var(--primary);
        font-weight: 700;
    }

    .guest-in-table {
        cursor: grab;
        font-size: 13px;
        background: #F3E8D6 !important;
        color: #8A6A2F !important;
        border: 1px solid var(--gold-soft);
        border-radius: 999px;
        padding: 7px 12px;
        font-weight: 600;
    }

    /* ---------------- TABLE CIRCLE ---------------- */

    .table-circle {
        height: 280px;
        border: 3px solid var(--gold-soft);
        border-radius: 50%;
        background: var(--card);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 18px;
        text-align: center;
        transition: .2s ease-in-out;
        position: relative;
        box-shadow: 0 18px 45px rgba(30, 58, 52, 0.06);
    }

    .table-circle:hover {
        border-color: var(--gold);
        transform: translateY(-3px);
        box-shadow: 0 22px 55px rgba(30, 58, 52, 0.09);
    }

    .table-full {
        border: 3px solid var(--rose) !important;
        box-shadow: 0 18px 45px rgba(207, 167, 160, 0.28);
    }

    .table-hover {
        border-color: var(--gold) !important;
        box-shadow: 0 0 0 6px rgba(198, 161, 91, 0.12),
                    0 18px 45px rgba(30, 58, 52, 0.08);
    }

    .table-circle small {
        color: var(--muted) !important;
        font-weight: 600;
    }

    .table-name-center {
        font-weight: 800;
        font-size: 17px;
        margin: 5px 0;
        color: var(--primary);
    }

    .table-guests {
        flex: 1;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-content: center;
        gap: 6px;
        overflow-y: auto;
        max-height: 140px;
        padding: 4px;
    }

    .table-actions {
        width: 100%;
    }

    /* ---------------- MODALS ---------------- */

    .modal-content {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 22px 55px rgba(30, 58, 52, 0.12);
    }

    .modal-header,
    .modal-footer {
        border-color: var(--border);
    }

    /* ---------------- SEARCH ---------------- */

    #guestSearch {
        background: var(--cream);
        border-color: var(--border);
    }

    #noGuestsMessage {
        color: var(--danger-text) !important;
        font-weight: 700;
        margin-bottom: 10px;
    }

    @@media (max-width: 768px) {
        .table-circle {
            height: 240px;
            border-radius: 26px;
        }
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

    const weddingId = @Model.Id;

    let draggedGuestId = null;

    // ---------------- SIGNALR ----------------
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/seatingHub")
    .build();

        connection.on("RefreshSeating", function () {
        // samo sync UI, ne reload
        location.reload();
        });

    connection.start()
    .catch(err => console.error(err));

    // ---------------- DRAG ----------------
    function handleDragStart(e) {
    draggedGuestId = e.currentTarget.dataset.guestId;
    }

    function initDrag() {

    document.querySelectorAll(".guest-card, .guest-in-table").forEach(el => {

    el.removeEventListener("dragstart", handleDragStart);
    el.addEventListener("dragstart", handleDragStart);

    });
    }

    document.addEventListener("DOMContentLoaded", initDrag);

    // ---------------- TABLE EFFECTS ----------------
    document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".table-circle").forEach(table => {

    table.addEventListener("dragenter", () => {
    table.classList.add("table-hover");
    });

    table.addEventListener("dragleave", () => {
    table.classList.remove("table-hover");
    });

    });

    });

    // ---------------- DROP ----------------
    function allowDrop(ev) {
    ev.preventDefault();
    }

        function drop(ev) {
        ev.preventDefault();

        const table = ev.currentTarget;
        table.classList.remove("table-hover");

        const tableId = parseInt(table.dataset.tableId);

        fetch('/Seating/AssignGuest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
        guestId: parseInt(draggedGuestId),
        tableId: tableId
        })
        })
        .then(res => res.json())
        .then(data => {

        if (!data.success) {
        alert(data.message || "Table is full");
        return;
        }

        // 🔥 INSTANT UI UPDATE (bez reload-a)
        moveGuestToTable(draggedGuestId, tableId);
        });
        }

    // ---------------- ADD GUEST ----------------
    function showAddGuestModal() {

    const modal = new bootstrap.Modal(
    document.getElementById('addGuestModal')
    );

    modal.show();
    }

    function addGuest() {

    const fullName = document.getElementById('guestName').value.trim();

    if (!fullName) {
    alert("Enter guest name");
    return;
    }

    fetch('/Seating/AddGuest', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
    weddingId: weddingId,
    fullName: fullName
    })
    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });

    }

    // ---------------- DELETE ----------------
    function deleteGuest(id) {

    if (!confirm("Delete guest?")) return;

    fetch('/Seating/DeleteGuest/' + id, {
    method: 'POST'
    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });

    }

    // ---------------- SEARCH (FIXED) ----------------
    function filterGuests() {

    const search = document.getElementById('guestSearch')
    .value
    .toLowerCase()
    .trim();

    const cards = document.querySelectorAll('.guest-card');

    let visibleCount = 0;

    cards.forEach(card => {

    const nameEl = card.querySelector('.guest-name');

    const name = (nameEl?.textContent || "")
    .toLowerCase()
    .trim();

    const match =
    search === "" ||
    name.startsWith(search);

    // Bootstrap-safe hide/show
    card.classList.toggle("d-none", !match);

    if (match) visibleCount++;
    });

    document.getElementById("noGuestsMessage").style.display =
    (search !== "" && visibleCount === 0) ? "block" : "none";
    }
    // ---------------- EDIT ----------------
    function showEditGuestModal(id) {

    fetch('/Seating/GetGuest?id=' + id)
    .then(r => r.json())
    .then(data => {

    if (!data.success) return;

    document.getElementById('editGuestId').value = data.guestId;
    document.getElementById('editGuestName').value = data.fullName;
    document.getElementById('editGuestSide').value = data.side ?? '';

    const modal = new bootstrap.Modal(
    document.getElementById('editGuestModal')
    );

    modal.show();
    });

    }

    function saveGuestEdit() {

    fetch('/Seating/EditGuest', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },

    body: JSON.stringify({
    guestId: parseInt(document.getElementById('editGuestId').value),
    fullName: document.getElementById('editGuestName').value,
    side: document.getElementById('editGuestSide').value
    })
    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });

    }

    // ---------------- TABLE MODAL ----------------

    function showAddTableModal() {

    document.getElementById("tableId").value = "";
    document.getElementById("tableName").value = "";
    document.getElementById("tableCapacity").value = 10;
    document.getElementById("tableSide").value = "";

    new bootstrap.Modal(document.getElementById("tableModal")).show();
    }

    function editTable(id, capacity, name) {

    document.getElementById("tableId").value = id;
    document.getElementById("tableName").value = name;
    document.getElementById("tableCapacity").value = capacity;
    document.getElementById("tableSide").value = "";

    new bootstrap.Modal(document.getElementById("tableModal")).show();
    }

    function saveTable() {

    fetch('/Seating/SaveTable', {

    method: 'POST',
    headers: { 'Content-Type': 'application/json' },

    body: JSON.stringify({
    id: parseInt(document.getElementById("tableId").value || 0),
    weddingId: weddingId,
    tableName: document.getElementById("tableName").value,
    capacity: parseInt(document.getElementById("tableCapacity").value),
    side: document.getElementById("tableSide").value
    })

    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });
    }

    function deleteTable(id) {

    if (!confirm("Delete table?")) return;

    fetch('/Seating/DeleteTable/' + id, {
    method: 'POST'
    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });
    }

        function reloadTables() {

        fetch(window.location.href)
        .then(r => r.text())
        .then(html => {

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");

        const newTables = doc.querySelector(".col-md-9");
        const oldTables = document.querySelector(".col-md-9");

        oldTables.innerHTML = newTables.innerHTML;

        initDrag();
        });
        }
        function moveGuestToTable(guestId, tableId) {

        // nađi guest card
        const guestCard = document.querySelector(`[data-guest-id="${guestId}"]`);

        if (!guestCard) return;

        // makni iz liste
        guestCard.remove();

        // napravi badge za stol
        const badge = document.createElement("div");
        badge.className = "badge bg-primary m-1 guest-in-table";
        badge.draggable = true;
        badge.dataset.guestId = guestId;
        badge.textContent = guestCard.querySelector(".guest-name")?.innerText || "Guest";

        // ubaci u table
        const container = document.getElementById(`table-guests-${tableId}`);
        container.appendChild(badge);

        initDrag();
        }

        function dropToGuestList(ev) {

        ev.preventDefault();

        fetch('/Seating/UnassignGuest', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json'
        },
        body: JSON.stringify({
        guestId: parseInt(draggedGuestId)
        })
        })
        .then(r => r.json())
        .then(data => {

        if (!data.success) {
        alert("Error");
        }

        });
        }
        

</script>