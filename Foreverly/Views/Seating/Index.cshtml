@model Foreverly.Models.Wedding

@{
    ViewData["Title"] = "Seating Plan";
    var tables = Model.Tables.ToList();
}

<h1 class="mb-4">Seating Plan</h1>

<div class="row">

    <!-- GUESTS -->
    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">

                <span>Guests</span>

                <button class="btn btn-sm btn-success"
                        onclick="showAddGuestModal()">
                    + Add Guest
                </button>

            </div>

            <div class="card-body">

                @foreach (var guest in Model.Guests.OrderBy(g => g.FullName))
                {
                    <div class="guest-card mb-2 d-flex justify-content-between align-items-center"
                         draggable="true"
                         data-guest-id="@guest.Id">

                        <span>@guest.FullName</span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                onclick="deleteGuest(@guest.Id)">
                            ✕
                        </button>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- TABLES -->
    <div class="col-md-9">

        <div class="row">

            @for (int i = 0; i < tables.Count; i++)
            {
                var table = tables[i];
                bool isFull = table.SeatingAssignments.Count >= table.Capacity;

                <div class="col-md-4 mb-4">

                    <div class="table-circle @(isFull ? "table-full" : "")"
                         data-table-id="@table.Id"
                         ondragover="allowDrop(event)"
                         ondrop="drop(event)">

                        <h5>Table @(i + 1)</h5>

                        <small>
                            @table.SeatingAssignments.Count / @table.Capacity
                        </small>

                        <hr />

                        @foreach (var seat in table.SeatingAssignments)
                        {
                            <div class="badge bg-primary m-1 guest-in-table"
                                 draggable="true"
                                 data-guest-id="@seat.GuestId">

                                @seat.Guest.FullName

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<!-- ADD GUEST MODAL -->

<div class="modal fade"
     id="addGuestModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Guest</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input id="guestName"
                       class="form-control"
                       placeholder="Name and Surname" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success"
                        onclick="addGuest()">
                    Add
                </button>

            </div>

        </div>

    </div>

</div>

<style>

    .guest-card {
        background: #f8f9fa;
        border: 1px solid #ddd;
        padding: 10px;
        border-radius: 10px;
        cursor: grab;
        transition: .2s;
    }

        .guest-card:hover {
            background: #eef3ff;
        }

    .guest-in-table {
        cursor: grab;
    }

    .table-circle {
        min-height: 250px;
        border: 3px solid #d6d6d6;
        border-radius: 50%;
        padding: 30px;
        text-align: center;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: .2s;
    }

        .table-circle:hover {
            border-color: #4e73df;
            transform: scale(1.02);
        }

    .table-full {
        border: 3px solid #dc3545 !important;
        box-shadow: 0 0 20px rgba(220,53,69,.4);
    }

    .table-hover {
        border-color: #0d6efd !important;
        box-shadow: 0 0 20px rgba(13,110,253,.35);
        transform: scale(1.04);
    }

</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

    const weddingId = @Model.Id;

    let draggedGuestId = null;

    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/seatingHub")
    .build();

    connection.on("RefreshSeating", function () {
    location.reload();
    });

    connection.start()
    .catch(err => console.error(err));

    document.querySelectorAll(".guest-card").forEach(el => {

    el.addEventListener("dragstart", e => {

    draggedGuestId =
    e.currentTarget.dataset.guestId;

    });

    });

    document.querySelectorAll(".guest-in-table").forEach(el => {

    el.addEventListener("dragstart", e => {

    draggedGuestId =
    e.currentTarget.dataset.guestId;

    });

    });

    function allowDrop(ev) {
    ev.preventDefault();
    }

    document.querySelectorAll(".table-circle").forEach(table => {

    table.addEventListener("dragenter", () => {
    table.classList.add("table-hover");
    });

    table.addEventListener("dragleave", () => {
    table.classList.remove("table-hover");
    });

    });

    function drop(ev) {

    ev.preventDefault();

    const table = ev.currentTarget;

    table.classList.remove("table-hover");

    const tableId = table.dataset.tableId;

    fetch('/Seating/AssignGuest', {

    method: 'POST',

    headers: {
    'Content-Type': 'application/json'
    },

    body: JSON.stringify({
    guestId: parseInt(draggedGuestId),
    tableId: parseInt(tableId)
    })

    })
    .then(res => res.json())
    .then(data => {

    if (!data.success) {
    alert(data.message || "Table is full");
    }

    });

    }

    function showAddGuestModal() {

    const modal = new bootstrap.Modal(
    document.getElementById('addGuestModal')
    );

    modal.show();
    }

    function addGuest() {

    const fullName =
    document.getElementById('guestName').value.trim();

    if (!fullName) {
    alert("Enter guest name");
    return;
    }

    fetch('/Seating/AddGuest', {

    method: 'POST',

    headers: {
    'Content-Type': 'application/json'
    },

    body: JSON.stringify({
    weddingId: weddingId,
    fullName: fullName
    })

    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });

    }

    function deleteGuest(id) {

    if (!confirm("Delete guest?"))
    return;

    fetch('/Seating/DeleteGuest/' + id, {

    method: 'POST'

    })
    .then(r => r.json())
    .then(data => {

    if (data.success) {
    location.reload();
    }

    });

    }

</script>