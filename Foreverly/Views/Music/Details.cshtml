@model Foreverly.Models.Band

@{
    ViewData["Title"] = "Band Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">@Model.Partner.Name</h1>
        <p class="text-muted">@Model.Description</p>
    </div>

    <div class="d-flex gap-2">
    <a asp-controller="Songs"
       asp-action="Create"
       asp-route-bandId="@Model.PartnerId"
       class="btn btn-primary rounded-pill px-4">
        + Add Song
    </a>

    <a asp-controller="Bands"
       asp-action="Edit"
       asp-route-id="@Model.PartnerId"
       class="btn btn-outline-warning rounded-pill px-4">
        Edit Band
    </a>

    <a asp-controller="Bands"
       asp-action="Delete"
       asp-route-id="@Model.PartnerId"
       class="btn btn-outline-danger rounded-pill px-4">
        Delete Band
    </a>
</div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Phone</h6>
                <h5>@Model.Partner.Phone</h5>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Email</h6>
                <h5>@Model.Partner.Email</h5>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Commission</h6>
                <h5>@Model.Partner.DefaultCommissionPercent%</h5>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Band Prices</h5>
    </div>

    <div class="card-body">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Duration</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var price in Model.BandPrices)
                {
                    <tr>
                        <td>@price.DayOfWeek</td>
                        <td>@price.DurationHours h</td>
                        <td>@price.Price KM</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h3 class="fw-bold mb-3">Playlists</h3>

@foreach (var playlist in Model.Playlists)
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <div>
        <h5 class="mb-0">@playlist.Name</h5>
        <small class="text-muted">@playlist.Description</small>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-warning text-dark">
            @playlist.PlaylistItems.Count items
        </span>

        <a asp-controller="Playlists"
           asp-action="Edit"
           asp-route-id="@playlist.Id"
           class="btn btn-sm btn-outline-warning">
            Edit
        </a>

        <a asp-controller="Playlists"
           asp-action="Delete"
           asp-route-id="@playlist.Id"
           class="btn btn-sm btn-outline-danger">
            Delete
        </a>
    </div>
</div>

        <div class="card-body">
            @if (playlist.PlaylistItems.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var item in playlist.PlaylistItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                @if (item.Song != null)
                                {
                                    <strong>@item.Song.Title</strong>
                                    <span class="text-muted">
                                        - @item.Song.Artist (@item.Song.Genre)
                                    </span>
                                }
                                else if (item.SongGroup != null)
                                {
                                    <strong>Group:</strong>
                                    <span>@item.SongGroup.Name</span>
                                }
                            </div>

                            @if (item.Song != null)
                            {
                                <div class="d-flex gap-2">
                                    <a asp-controller="Songs"
                                       asp-action="Edit"
                                       asp-route-id="@item.Song.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="Songs"
                                       asp-action="Delete"
                                       asp-route-id="@item.Song.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">No songs in this playlist.</p>
            }
        </div>
    </div>
}

<a asp-controller="Music" asp-action="Index" class="btn btn-secondary">
    Back to Music
</a>