@model Foreverly.Models.Partner

@{
    ViewData["Title"] = "Add Partner";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow border-0">

            <div class="card-header bg-dark text-white">
                <h2 class="mb-0">Add New Partner</h2>
            </div>

            <div class="card-body">

                <form asp-action="Create" method="post"
                      onsubmit="alert('FORM SUBMITTED');">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="ViewBag.CategoryId">
                            </select>

                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label"></label>

                            <input asp-for="Name" class="form-control" />

                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactPerson" class="form-label">
                                Contact Person
                            </label>

                            <input asp-for="ContactPerson" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label>

                            <input asp-for="Phone" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>

                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label"></label>

                            <input asp-for="Address" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DefaultCommissionPercent"
                                   class="form-label">
                                Commission %
                            </label>

                            <input asp-for="DefaultCommissionPercent"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />

                            <span asp-validation-for="DefaultCommissionPercent" class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Notes" class="form-label"></label>

                            <textarea asp-for="Notes"
                                      rows="4"
                                      class="form-control"></textarea>
                        </div>

                    </div>

                    <div class="text-end">

                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Save Partner
                        </button>

                    </div>

                </form>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}