@model Foreverly.Models.Partner

@{
    ViewData["Title"] = "Partner Details";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow border-0">

            <div class="card-header bg-dark text-white">
                <h2 class="mb-0">@Model.Name</h2>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Category
                    </div>
                    <div class="col-md-8">
                        @Model.Category?.Name
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Contact Person
                    </div>
                    <div class="col-md-8">
                        @Model.ContactPerson
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Phone
                    </div>
                    <div class="col-md-8">
                        @Model.Phone
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Email
                    </div>
                    <div class="col-md-8">
                        @Model.Email
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Address
                    </div>
                    <div class="col-md-8">
                        @Model.Address
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4 fw-bold">
                        Commission
                    </div>
                    <div class="col-md-8">
                        <span class="badge bg-success fs-6">
                            @Model.DefaultCommissionPercent %
                        </span>
                    </div>
                </div>

                <hr />

                <h5>Notes</h5>

                <div class="alert alert-light border">
                    @(string.IsNullOrEmpty(Model.Notes)
                        ? "No notes available."
                        : Model.Notes)
                </div>

            </div>

            <div class="card-footer text-end">

                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                       class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>