@model Foreverly.Models.Song

@{
    ViewData["Title"] = "Edit Song";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-header bg-white">
                <h1 class="mb-0">Edit Song</h1>
            </div>

            <div class="card-body">

                <form asp-action="Edit">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden" asp-for="Id" />

                    <div class="row g-4">

                        <div class="col-md-12">
                            <label asp-for="Title"
                                   class="form-label">
                                Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Artist"
                                   class="form-label">
                                Artist
                            </label>

                            <input asp-for="Artist"
                                   class="form-control" />

                            <span asp-validation-for="Artist"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Genre"
                                   class="form-label">
                                Genre
                            </label>

                            <input asp-for="Genre"
                                   class="form-control" />

                            <span asp-validation-for="Genre"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to Songs
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}